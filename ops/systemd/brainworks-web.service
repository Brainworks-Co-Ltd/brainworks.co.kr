[Unit]
Description=brainworks.co.kr Next.js
After=network.target postgresql.service

[Service]
User=brainworks
WorkingDirectory=/srv/brainworks/current
EnvironmentFile=/etc/brainworks/app.env
# 예약 게시 시각 변환이 프로세스 시간대를 따르므로 Asia/Seoul로 고정한다
Environment=PORT=3000 HOSTNAME=127.0.0.1 TZ=Asia/Seoul
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3
# Next.js는 SIGTERM에 143으로 끝난다
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
